{
  "name": "smilife/pm-backend",
  "type": "project",
  "description": "Project management platform backend migrated onto ThinkPHP.",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "topthink/framework": "8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "app\\": "app/"
    }
  },
  "scripts": {
    "db:init": "@php scripts/db-init.php",
    "db:migrate": "@php scripts/db-migrate.php",
    "db:seed": "@php scripts/db-seed.php",
    "db:clean-legacy": "@php scripts/db-clean-legacy.php",
    "test:smoke": "@php scripts/api-smoke-test.php"
  }
}